# Performance monitoring is now a runtime toggle (debug_mode in web config).

menu "NINA Display"

choice NINA_PANEL_FAMILY
    prompt "Panel shape family"
    default NINA_FAMILY_SQUARE
    help
        Selects the shape family this binary is built for. The family decides
        which layout sources compile, the OTA asset name the update checker
        matches, the CMake project name stamped into the image header, and
        which panel controller the board layer will accept at boot.

    config NINA_FAMILY_SQUARE
        bool "Square 720x720 (ESP32-P4-WIFI6-Touch-LCD-4B, ST7703)"

    config NINA_FAMILY_ROUND
        bool "Round (3.4C 800x800 and 4C 720x720, JD9365)"
endchoice

endmenu
