# Performance monitoring is now a runtime toggle (debug_mode in web config).

menu "NINA Display"

choice NINA_PANEL_FAMILY
    prompt "Panel shape family"
    default NINA_FAMILY_SQUARE
    help
        Selects the shape family this binary is built for. The family decides
        which layout sources compile, the OTA asset name the update checker
        matches, the CMake project name stamped into the image header, and
        which panel controller the board layer will accept at boot.

    config NINA_FAMILY_SQUARE
        bool "Square 720x720 (ESP32-P4-WIFI6-Touch-LCD-4B, ST7703)"

    config NINA_FAMILY_ROUND
        bool "Round (3.4C 800x800 and 4C 720x720, JD9365)"
endchoice

# espressif/esp_hosted 3.1.0 (published 2026-11-05) made its USB host
# dependencies conditional on these three options, with rules of the form
# "$CONFIG{...} == 1". The component manager evaluates those rules for every
# published version each time CMake configures, and esp_hosted 2.12.3 (the
# version this project pins) does not define the options, so every configure
# ended with "Missing required kconfig option after retry". They must exist
# in sdkconfig.json and must be integers: a bool fails the rule with
# 'Invalid boolean "1" in "if" clause'. Zero keeps the USB dependencies out.
# Remove once the pinned esp_hosted defines them itself.
config ESP_HOSTED_HOST_USB_CDC_ACM_MANIFEST
    int
    default 0

config ESP_HOSTED_HOST_USB_CHERRYUSB_MANIFEST
    int
    default 0

config ESP_HOSTED_HOST_USB_RNDIS_MANIFEST
    int
    default 0

endmenu
